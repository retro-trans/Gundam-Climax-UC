 "decisions": [
  "Black-square markers (U+25A0 x3) around unused/placeholder unit names rendered as ASCII '###' on both sides; name inside translated per glossary.",
  "Short (+0x80, 19-byte) unit names use the glossary name when it fits; otherwise abbreviated (see row notes).",
  "Pilot short names (+0x5E) use glossary en_short; full names (+0xE) use glossary en.",
  "MA-form units use '(MA Mode)' consistently.",
  "Generic soldier slots: 'Soldier A/B (<faction>)' per glossary; personality variants Gentle/Calm/Hot-blooded per glossary."
 ],
 "uncertain": [
  "S01370-S01407 (### rows): ASCII '###' chosen for the black-square markers; orchestrator may prefer dropping them or restoring the SJIS squares.",
  "S01355: 'Gundam Mk-II (T)' (Titans) to fit 19 bytes; alternative 'Mk-II (Titans)'.",
