work/translation/**/*.txt
work/glossary/_raw_names.json

__pycache__/
*.pyc

# third-party binaries (xdelta3 downloaded from github.com/jmacd/xdelta-gpl v3.1.0)
work/bin/

# game artwork: UI screenshots and texture previews stay local
work/ui/**/*.png
work/translation/en/tex/
# patches are published as release assets, not committed
work/output/
